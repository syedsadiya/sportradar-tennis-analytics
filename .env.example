# Sportradar Tennis v3 API Credentials
# Replace with your actual Sportradar API key.
# If left blank, the application gracefully utilizes cached responses in data/raw/
SPORTRADAR_API_KEY=offline_mode

# Relational Database Connection (MySQL with PyMySQL via SQLAlchemy)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/sportradar_tennis

# Optional Configuration
API_TIMEOUT=15
RATE_LIMIT_SLEEP=1.5
